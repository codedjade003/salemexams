# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Generate this hash with: npm run hash:admin -- "your-strong-password"
ADMIN_PASSCODE_HASH=scrypt$16384$8$1$replace_salt$replace_digest
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB_NAME=salemexams

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=production
# PORT is set by Render automatically.
# Time zone for dates printed on report cards (IANA name). Render servers run in UTC.
APP_TIMEZONE=Africa/Lagos
# On Render these are detected automatically (RENDER / RENDER_EXTERNAL_URL):
#   TRUST_PROXY=true, KEEP_ALIVE_ENABLED=true, KEEP_ALIVE_URL=<your public URL>/api/keep-alive
# Set them yourself only on another host (behind nginx: TRUST_PROXY=loopback).

# ---------------------------------------------------------------------------
# Students
# ---------------------------------------------------------------------------
# New accounts and password resets start with this password; students must change it.
DEFAULT_STUDENT_PASSWORD=salem
DEFAULT_MAX_ATTEMPTS=3
# Optional: hide corrections for this long after submit (default 25 min = 1500000 ms)
# RESULT_RELEASE_DELAY_MS=1500000
# Optional: how long after 00:00 late-arriving answers are still accepted (default 90000 ms)
# SUBMIT_GRACE_MS=90000

# ---------------------------------------------------------------------------
# Frontend build (read by Vite at build time)
# ---------------------------------------------------------------------------
# Leave empty when the API serves the frontend (same domain, recommended).
# Only set it if the frontend is hosted on a different domain from the API.
VITE_API_BASE=
# Optional student idle auto-logout on non-exam screens (default 180000 ms = 3 minutes).
# VITE_STUDENT_IDLE_TIMEOUT_MS=180000

# ---------------------------------------------------------------------------
# Rarely needed
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call the API cross-domain. Only needed with VITE_API_BASE.
# CORS_ORIGINS=https://exams.example.com
# Optional DNS override for environments where SRV lookups fail (example: 1.1.1.1,8.8.8.8)
MONGO_DNS_SERVERS=
