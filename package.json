  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"vite\" \"node --watch server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "hash:admin": "node scripts/hash-admin-password.mjs",
    "audit:sessions": "node scripts/audit-sessions.mjs",
    "audit:sessions:fix": "node scripts/audit-sessions.mjs --fix --finalize-expired",
    "audit:sessions:normalize": "node scripts/audit-sessions.mjs --fix --normalize-shape --finalize-expired",
    "audit:sessions:normalize:dry": "node scripts/audit-sessions.mjs --normalize-shape",
    "test:smoke": "node scripts/smoke-e2e.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predev": "node scripts/copy-pyodide.mjs",
    "prebuild": "node scripts/copy-pyodide.mjs",
    "test:load": "node scripts/load-test.mjs"
